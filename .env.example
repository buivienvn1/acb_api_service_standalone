# Copy to .env and fill secrets generated by: python -m acb_api_service.bootstrap
ACB_API_DATABASE_PATH=/opt/acb-api/data/acb_api/acb_api.sqlite3
ACB_API_ENCRYPTION_KEY=
ACB_API_ADMIN_USERNAME=admin
ACB_API_ADMIN_PASSWORD_HASH=
ACB_API_SESSION_SECRET=
ACB_API_PUBLIC_BASE_URL=https://your-domain.example
ACB_API_COOKIE_SECURE=true
ACB_API_POLL_INTERVAL_SECONDS=20
ACB_API_POLL_CONCURRENCY=3
ACB_API_STALE_AFTER_SECONDS=600
ACB_API_RATE_LIMIT_PER_MINUTE=60
ACB_API_SESSION_TTL_SECONDS=28800
ACB_API_ACB_TIMEOUT_SECONDS=20
# Binance is optional; credentials are entered per customer in the admin UI.
BINANCE_BASE_URL=https://api.binance.com
# Optional global HTTP/HTTPS/SOCKS5 proxy, overridden by a tenant proxy in the admin UI.
BINANCE_PROXY=
BINANCE_REQUEST_TIMEOUT_SECONDS=20
BINANCE_HISTORY_LIMIT=100
BINANCE_HISTORY_DAYS=7
